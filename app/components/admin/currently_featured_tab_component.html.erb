<%= render "govuk_publishing_components/components/heading", {
  text: "Currently featured",
} %>

<% if featured.many? && !read_only %>
  <p class="govuk-body">
    <%= link_to "Reorder pages", reorder_path, class: "govuk-link" %>
  </p>
<% end %>

<% if featured.present? %>
  <div class="app-view-features__table govuk-!-margin-bottom-8">
    <%= table(nil, live) %>
  </div>
<% else %>
  <p class="govuk-body">
    There are currently no featured pages.
  </p>
<% end %>

<% if remaining.present? %>
  <div class="app-view-features__table">
    <%= table("Other pages featured but not shown on the page", remaining) %>
  </div>
<% end %>

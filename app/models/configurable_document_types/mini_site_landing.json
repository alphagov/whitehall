{
  "key": "mini_site_landing",
  "title": "Mini site",
  "description": "Use this to create a mini site landing page with optional child pages.",
  "forms": {
    "documents": {
      "fields": {
        "body": {
          "title": "Body",
          "description": "The main content of the page",
          "required": true,
          "block": "govspeak",
          "attribute_path": ["block_content", "body"],
          "translatable": true
        },
        "lead_organisations": {
          "title": "Lead organisations",
          "block": "ordered_select_with_search_tagging",
          "container": "organisations",
          "attribute_path": ["lead_organisation_ids"],
          "size": 4,
          "translatable": false
        },
        "supporting_organisations": {
          "title": "Supporting organisations",
          "block": "select_with_search_tagging",
          "container": "organisations",
          "attribute_path": ["supporting_organisation_ids"],
          "translatable": false
        },
        "nation_applicability": {
          "title": "Nation applicability",
          "description": "Which UK nations this content applies to",
          "block": "nation_applicability",
          "attribute_path": ["block_content", "nation_applicability"],
          "translatable": false
        }
      }
    },
    "social_media_accounts": {
      "dynamic": true,
      "label": "Social media accounts",
      "fields": {
        "social_media_links": {
          "title": "Social media accounts",
          "block": "default_array",
          "add_another_button_text": "Add a social media account",
          "attribute_path": ["block_content", "social_media_links"],
          "translatable": true,
          "fields": {
            "social_media_service_name": {
              "title": "Channel",
              "block": "default_select",
              "attribute_path": ["social_media_service_name"],
              "blank_option_label": "Select channel",
              "translatable": true,
              "options": [
                {
                  "label": "X",
                  "value": "X"
                },
                {
                  "label": "Facebook",
                  "value": "Facebook"
                },
                {
                  "label": "YouTube",
                  "value": "YouTube"
                },
                {
                  "label": "Flickr",
                  "value": "Flickr"
                },
                {
                  "label": "Blog",
                  "value": "Blog"
                },
                {
                  "label": "Pinterest",
                  "value": "Pinterest"
                },
                {
                  "label": "LinkedIn",
                  "value": "LinkedIn"
                },
                {
                  "label": "Google Plus",
                  "value": "Google Plus"
                },
                {
                  "label": "Foursquare",
                  "value": "Foursquare"
                },
                {
                  "label": "Email",
                  "value": "Email"
                },
                {
                  "label": "Instagram",
                  "value": "Instagram"
                },
                {
                  "label": "Bluesky",
                  "value": "Bluesky"
                },
                {
                  "label": "Threads",
                  "value": "Threads"
                },
                {
                  "label": "Other",
                  "value": "Other"
                }
              ]
            },
            "title": {
              "title": "Title",
              "block": "default_string",
              "attribute_path": ["title"],
              "translatable": true
            },
            "url": {
              "title": "URL",
              "block": "default_string",
              "attribute_path": ["url"],
              "translatable": true
            }
          }
        }
      }
    }
  },
  "schema": {
    "attributes": {
      "body": {
        "type": "string"
      },
      "nation_applicability": {
        "type": "object"
      },
      "social_media_links": {
        "type": "array",
        "attributes": {
          "social_media_service_name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "validations": {
      "presence": {
        "attributes": ["body"]
      },
      "length": {
        "attributes": ["body"],
        "maximum": 16777215
      },
      "safe_html": {
        "attributes": ["body"]
      },
      "no_footnotes_allowed": {
        "attributes": ["body"]
      },
      "embedded_contacts_exist": {
        "attributes": ["body"],
        "on": "publish"
      },
      "nation_applicability": {
        "attributes": ["nation_applicability"]
      },
      "social_media_links": {
        "attributes": ["social_media_links"],
        "fields": {
          "service_field": "social_media_service_name",
          "url_field": "url",
          "title_field": "title"
        }
      }
    }
  },
  "presenters": {
    "publishing_api": {
      "details": {
        "body": "govspeak",
        "social_media_links": "social_media_links"
      },
      "links": [
        "organisations"
      ]
    }
  },
  "settings": {
    "base_path_prefix": "/government",
    "publishing_api_schema_name": "mini_site",
    "publishing_api_document_type": "mini_site_landing",
    "rendering_app": "frontend",
    "images": {
      "enabled": true,
      "usages": {
        "header": {
          "kinds": ["topical_event_header"],
          "multiple": false,
          "caption_enabled": true
        },
        "govspeak_embed": {
          "kinds": ["default"],
          "multiple": true,
          "caption_enabled": true
        }
      }
    },
    "send_change_history": false,
    "file_attachments_enabled": false,
    "organisations": null,
    "backdating_enabled": false,
    "history_mode_enabled": false,
    "taxon": {
      "enabled": false,
      "required": false
    },
    "translations_enabled": false,
    "allowed_child_document_types": [
      {
        "document_type": "mini_site_child"
      }
    ]
  }
}

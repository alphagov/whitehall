<% content_for :page_title, @edition.title %>
<% content_for :title, @edition.title %>
<% content_for :context, @edition.title %>
<% content_for :title_margin_bottom, 4 %>
<% content_for :back_link do %>
  <%= render "govuk_publishing_components/components/back_link", {
    href: admin_edition_path(@edition),
  } %>
<% end %>

<div class="govuk-!-margin-bottom-8">
  <%= render "components/secondary_navigation", {
    aria_label: "Document navigation",
    items: secondary_navigation_tabs_items(@edition, request.path),
  } %>
</div>

<%= render "govuk_publishing_components/components/heading", {
  text: "Child pages",
  font_size: "l",
  margin_bottom: 4,
} %>
<p class="govuk-body">Child pages can be added to the navigation menu or featured section.</p>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= render partial: "admin/editions/show/child_documents", locals: {
      heading: nil,
      section_class: nil,
      edition: @edition,
      child_editions: @child_editions,
      link_text: "Edit child pages",
      empty_message: "There are currently no child pages.",
    } %>
  </div>
</div>

<% if @edition.can_create_new_child_documents? %>
  <%= render "govuk_publishing_components/components/button", {
    text: "Add new child page",
    href: @new_child_page_path,
  } %>
<% end %>

<% content_for :page_title, @edition.title %>
<% content_for :title, @edition.title %>
<% content_for :context, @edition.title %>
<% content_for :title_margin_bottom, 4 %>
<% content_for :back_link do %>
  <%= render "govuk_publishing_components/components/back_link", {
    href: admin_edition_path(@edition),
  } %>
<% end %>

<div class="govuk-!-margin-bottom-8">
  <%= render "components/secondary_navigation", {
    aria_label: "Document navigation",
    items: secondary_navigation_tabs_items(@edition, request.path),
  } %>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= render "govuk_publishing_components/components/heading", {
      text: "Navigation",
      font_size: "l",
      margin_bottom: 4,
    } %>

    <p class="govuk-body">Add an optional navigation menu that will appear on each page of your mini site.  You can include up to <%= StandardEdition::HasNavigation::MAX_CHILD_PAGES_IN_NAV %> child pages.</p>

    <% if @child_editions.blank? %>
      <%= render "govuk_publishing_components/components/inset_text", {
        text: "There are no child pages.",
      } %>
    <% else %>
      <% if @edition.editable? %>
        <%= render "govuk_publishing_components/components/button", {
          text: @navigation_items.any? ? "Update navigation menu" : "Add navigation menu",
          href: edit_admin_standard_edition_navigation_path(@edition),
        } %>
      <% end %>

      <section class="app-view-summary__section">
        <% if @navigation_items.any? %>
          <%= render "govuk_publishing_components/components/table", {
            head: [
              {
                text: "Title",
              },
              {
                text: "State",
              },
              {
                text: "Actions",
              },
            ],
            rows: @navigation_items.sort_by(&:created_at).map do |navigation_item|
              [
                { text: navigation_item.child_edition.title },
                { text: render(Admin::Editions::TagsComponent.new(navigation_item.child_edition)) },
                {
                  text: link_to(safe_join(["View", tag.span(" #{navigation_item.child_edition.title}", class: "govuk-visually-hidden")]), admin_edition_path(navigation_item.child_edition), class: "govuk-link govuk-link--no-visited-state"),
                },
              ]
            end,
          } %>
        <% end %>
      </section>
    <% end %>
  </div>
</div>

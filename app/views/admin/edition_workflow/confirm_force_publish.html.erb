<% content_for :context, @edition.title %>
<% content_for :page_title, "Force publish: #{@edition.title}" %>
<% content_for :title, "Force publish" %>
<% content_for :title_margin_bottom, 6 %>

<div class="govuk-grid-row">
  <section class="govuk-grid-column-two-thirds">
    <%= form_tag force_publish_admin_edition_path(@edition, lock_version: @edition.lock_version), class: "well force-publish-form" do %>
      <%= render "govuk_publishing_components/components/warning_text", {
        text: "You must only force publish documents when no other editor is available to review and publish your work, for example out of hours or in an emergency.",
      } %>

      <%= render "govuk_publishing_components/components/radio", {
        name: "reason",
        id: "reason",
        heading: "Reason for force publishing",
        heading_level: 2,
        heading_size: "l",
        items: [
          {
            value: "minor-change",
            text: "Minor or trivial change",
          },
          {
            value: "pre-verified",
            text: "Checked offline or pre-verified",
          },
          {
            value: "urgent",
            text: "Urgent or time sensitive",
          },
          {
            value: "no-reviewer",
            text: "No reviewer available",
          },
          {
            value: "other",
            text: "Other",
            conditional: render("govuk_publishing_components/components/input", {
              name: "other_reason",
              id: "other_reason",
              hint: "Provide a brief explanation for why this force publish is necessary.",
            }),
          },
        ],
      } %>

      <div class="govuk-button-group govuk-!-margin-bottom-6">
        <%= render "govuk_publishing_components/components/button", {
          text: "Force publish",
          destructive: true,
        } %>

        <%= link_to("Cancel", [:admin, @edition], class: "govuk-link govuk-link--no-visited-state") %>
      </div>
    <% end %>
  </section>
</div>
